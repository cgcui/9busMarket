{
  "identifier": "Paper9Bus-ISONE-FixedRenewable-Physics-v1",
  "case_ids": ["C0_NO_RENEWABLE", "C1_BTM_SOLAR_ONLY", "C2_BTM_SOLAR_PLUS_FIXED_WIND"],
  "frozen_case": "data/action_space_v2_simulator/case_snapshot/frozen_case9_blv.json",
  "gross_load_bridge": "data/public/isone_2024_2026/paper9bus_2024_2026_gross_load_bridge_v1.parquet",
