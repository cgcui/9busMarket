  "solver": {
    "backend": "existing frozen solve_dcopf",
    "k_g1": 1.0,
    "k_g3": 1.0,
    "forecast_fields_allowed_in_physical_solver": false
  },
  "stop_rule": "Stop after TRAIN 168h smoke classification; no full TRAIN, DEV, HOLDOUT, Action-Space-v2, SFT, or GRPO changes."
